export global Theme {
    out property <color> paper: #ffffff;
    out property <color> ink: #000000;
    out property <color> key-rule: Theme.ink;
    out property <color> clear: transparent;
    out property <color> surface: #f4f4f4;
    out property <color> selection: #ebebeb;
    out property <color> secondary: #555555;
    out property <color> disabled: #888888;
    out property <color> separator: #cccccc;
    out property <length> radius: 8px;
    out property <length> unit: 4px;
    out property <length> gap: 8px;
    out property <length> inset: 16px;
    out property <length> touch-min: 88px;
    out property <length> touch: 88px;
    out property <length> chrome-height: 72px;
    out property <length> keyboard-height: 420px;
    out property <length> key-height: (Theme.keyboard-height - Theme.unit * 5) / 4;
    out property <length> sidebar-width: 620px;
    out property <length> close-width: 72px;
    out property <length> icon-size: 36px;
    out property <length> keyboard-icon-width: 40px;
    out property <length> keyboard-icon-height: 28px;
    out property <length> type-small: 25px;
    out property <length> type-body: 30px;
    out property <length> type-key: 25px;
    out property <length> type-letter: 36px;
    out property <length> type-legend: 20px;
    out property <length> space-height: 48px;
    out property <length> key-radius: 8px;
    out property <length> key-hold-slop: 16px;
    out property <duration> key-hold: 500ms;
    out property <duration> action-feedback: 100ms;
    out property <length> hairline: 1px;
    out property <length> rule: 2px;
    out property <length> tab-width: 168px;
    out property <length> tab-width-max: 232px;
    out property <length> state-width: 28px;
    out property <duration> selection-hold: 500ms;
}
